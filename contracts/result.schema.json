{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "tag": {
      "enum": [
        "temperature.requested",
        "mode.requested",
        "alarm.ack",
        "fault.inject",
        "fan.supply.request",
        "fan.supply.enable",
        "fan.extract.request",
        "fan.extract.enable",
        "actuator.outdoor.request",
        "actuator.exhaust.request",
        "actuator.heat.request",
        "actuator.cool.request",
        "actuator.recovery.request"
      ]
    },
    "status": {
      "enum": [
        "received",
        "accepted",
        "rejected",
        "executed"
      ]
    },
    "reason": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$"
    }
  },
  "required": [
    "schema_version",
    "command_id",
    "tag",
    "status",
    "reason",
    "timestamp"
  ]
}